---
import { ClientRouter } from "astro:transitions";

import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
import {
  accentColor,
  accentColorHover,
  backgroundColor,
  foregroundColor,
  accentColorHover2,
} from "../data/theme";
---

<!doctype html>
<html lang="cz">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta
      name="description"
      content="Generic hacker-themed security blog and target index built with Astro."
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>generic hacker site</title>
  </head>
  <body>
    <Navbar />
    <main id="main-content" class="site-main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<ClientRouter />

<style
  is:global
  define:vars={{
    accentColor,
    backgroundColor,
    foregroundColor,
    accentColorHover,
    accentColorHover2,
  }}
>
  @import url("https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap");

  @layer reset {
    *, *::before, *::after {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body,
    h1,
    h2,
    h3,
    p,
    ul,
    ol,
    dl,
    dd,
    dt {
      margin: 0;
    }

    img,
    svg {
      display: block;
      max-width: 100%;
    }

    a {
      text-decoration: none;
    }
  }

  @layer tokens {
    :root {
      --space-1: 0.5rem;
      --space-2: 0.75rem;
      --space-3: 1rem;
      --space-4: 1.25rem;
      --space-6: 1.5rem;
      --space-8: 2rem;
      --radius-sm: 0.75rem;
      --radius-md: 1rem;
      --radius-lg: 1.5rem;
      --shadow-card: 0 0 0 1px color-mix(in srgb, var(--accentColor) 15%, transparent);
      --border-soft: color-mix(in srgb, var(--accentColor) 45%, transparent);
    }
  }

  @layer base {
    :root {
      min-height: 100vh;
      background-color: var(--backgroundColor);
      color: var(--foregroundColor);
      font-family: "JetBrains Mono", monospace;
    }

    body {
      width: 100%;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      overflow-x: hidden;
      background:
        radial-gradient(circle at top, color-mix(in srgb, var(--accentColor) 10%, transparent), transparent 30%),
        var(--backgroundColor);
      color: var(--foregroundColor);
    }

    .site-main {
      width: min(100%, 1200px);
      margin: 0 auto;
      padding: 1rem 1.25rem 2rem;
      line-height: 1.6;
      box-sizing: border-box;
    }

    h1 {
      font-size: clamp(2.2rem, 5vw, 4rem);
      line-height: 1.05;
    }

    button,
    input,
    textarea,
    select {
      font: inherit;
    }

    :focus-visible {
      outline: 2px solid var(--accentColorHover2);
      outline-offset: 3px;
    }
  }

  @layer components {
    a {
      color: var(--accentColor);
      transition: color 0.2s ease;
    }

    a:hover {
      color: var(--accentColorHover);
    }
  }

  @layer utilities {
    .sr-only {
      position: absolute;
      width: 1px;
      height: 1px;
      margin: -1px;
      padding: 0;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
  }
</style>
