---
const { name, sector, severity, score, status, summary, note, tag } = Astro.props;
---

<section class="target-card">
  <div class="target-card__topline">
    <span class="target-card__tag">{tag}</span>
    <span class="target-card__severity">{severity}</span>
  </div>

  <header class="target-card__header">
    <p class="target-card__eyebrow">target // {sector}</p>
    <h2 class="target-card__name">{name}</h2>
  </header>

  <div class="target-card__meta">
    <div>
      <dt>status</dt>
      <dd>{status}</dd>
    </div>
    <div>
      <dt>impact</dt>
      <dd>{score}</dd>
    </div>
  </div>

  <p class="target-card__summary">{summary}</p>
  <p class="target-card__note">{note}</p>
</section>

<style>
  @layer components {
    .target-card {
      container-type: inline-size;
      container-name: target-card;
      display: grid;
      grid-template-rows: minmax(2.4rem, auto) minmax(5.8rem, auto) minmax(4.6rem, auto) auto auto;
      align-content: start;
      gap: 1rem;
      min-width: 0;
      height: 100%;
      padding: var(--space-5);
      border: 1px solid color-mix(in srgb, var(--color-accent) 52%, transparent);
      border-radius: var(--radius-md);
      background: linear-gradient(
        180deg,
        color-mix(in srgb, var(--color-background) 88%, black 12%),
        color-mix(in srgb, var(--color-background) 78%, var(--color-accent) 22%)
      );
      box-shadow: var(--shadow-card);
    }

    .target-card__topline {
      display: flex;
      justify-content: space-between;
      gap: 0.65rem;
      align-items: center;
      flex-wrap: nowrap;
      min-height: 2.4rem;
    }

    .target-card__tag,
    .target-card__severity {
      display: inline-flex;
      align-items: center;
      border-radius: var(--radius-pill);
      padding: 0.35rem 0.7rem;
      font-size: var(--font-size-badge);
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .target-card__tag {
      background: color-mix(in srgb, var(--color-accent-hover-2) 18%, transparent);
      color: var(--color-accent-hover-2);
    }

    .target-card__severity {
      background: color-mix(in srgb, var(--color-accent) 18%, transparent);
      color: var(--color-accent);
    }

    .target-card__header {
      display: grid;
      gap: 0.5rem;
      min-height: 5.8rem;
    }

    .target-card__eyebrow {
      margin: 0;
      color: var(--color-accent-hover-2);
      font-size: var(--font-size-badge);
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    .target-card__name {
      margin: 0;
      font-size: clamp(1.6rem, 3vw, 2.3rem);
      line-height: 1.1;
      color: var(--color-foreground);
    }

    .target-card__meta {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
      min-width: 0;
      min-height: 4.6rem;
      align-items: stretch;
    }

    .target-card__meta div {
      display: grid;
      align-content: start;
      min-width: 0;
      padding: 0.8rem 0.9rem;
      background: color-mix(in srgb, var(--color-background) 84%, black 16%);
      border: 1px solid color-mix(in srgb, var(--color-accent) 18%, transparent);
      border-radius: var(--radius-xs);
    }

    .target-card__meta dt {
      margin: 0 0 0.35rem;
      color: var(--color-accent-hover);
      font-size: 0.7rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .target-card__meta dd {
      margin: 0;
      font-size: 0.95rem;
    }

    .target-card__summary,
    .target-card__note {
      margin: 0;
      overflow-wrap: anywhere;
      word-break: break-word;
      color: color-mix(in srgb, var(--color-foreground) 88%, white 12%);
    }

    .target-card__note {
      color: var(--color-accent-hover-2);
      border-left: 2px solid color-mix(in srgb, var(--color-accent-hover-2) 55%, transparent);
      padding-left: 0.8rem;
    }

    .target-card__name,
    .target-card__tag,
    .target-card__severity,
    .target-card__meta dd {
      overflow-wrap: anywhere;
      word-break: break-word;
    }

    .target-card__tag,
    .target-card__severity {
      white-space: nowrap;
      text-overflow: ellipsis;
      overflow: hidden;
    }

    @container target-card (max-width: 24rem) {
      .target-card {
        grid-template-rows: auto auto auto auto auto;
      }

      .target-card__topline,
      .target-card__header,
      .target-card__meta {
        min-height: 0;
      }

      .target-card__meta {
        grid-template-columns: 1fr;
      }
    }
  }
</style>
