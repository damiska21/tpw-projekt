---
const {
  href,
  type = "button",
  variant = "primary",
  size = "md",
  ariaLabel,
  class: className = "",
  isExternal = false,
  ...attrs
} = Astro.props;

const Element = href ? "a" : "button";
const rel = isExternal ? "noopener noreferrer" : undefined;
const target = isExternal ? "_blank" : undefined;

import {
  accentColor,
  accentColorHover,
  backgroundColor,
  foregroundColor,
  accentColorHover2,
} from "../data/theme";
---

<Element
  {...attrs}
  href={href}
  type={href ? undefined : type}
  target={target}
  rel={rel}
  aria-label={ariaLabel}
  class:list={[
    "button",
    `button--${variant}`,
    `button--${size}`,
    className,
  ]}
>
  <slot />
</Element>

<style define:vars={{ accentColor, backgroundColor, foregroundColor, accentColorHover, accentColorHover2 }}>
  @layer components {
    .button {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border: 1px solid var(--accentColor);
      border-radius: 999px;
      padding: 0.7rem 1.1rem;
      cursor: pointer;
      transition:
        transform 0.2s ease,
        background-color 0.2s ease,
        color 0.2s ease,
        border-color 0.2s ease;
      text-decoration: none;
      font-weight: 700;
      line-height: 1.2;
      background: var(--backgroundColor);
      color: var(--foregroundColor);
    }

    .button:hover {
      transform: translateY(-1px);
    }

    .button:focus-visible {
      outline: 2px solid var(--accentColorHover2);
      outline-offset: 3px;
    }

    .button--primary {
      border-color: color-mix(in srgb, var(--accentColor) 75%, transparent);
      background: color-mix(in srgb, var(--backgroundColor) 75%, var(--accentColor) 25%);
      color: var(--accentColor);
    }

    .button--primary:hover {
      background: color-mix(in srgb, var(--backgroundColor) 60%, var(--accentColor) 40%);
      color: var(--accentColorHover2);
    }

    .button--secondary {
      border-color: color-mix(in srgb, var(--foregroundColor) 50%, transparent);
      background: transparent;
      color: var(--foregroundColor);
    }

    .button--secondary:hover {
      border-color: color-mix(in srgb, var(--accentColorHover2) 75%, transparent);
      color: var(--accentColorHover2);
    }

    .button--sm {
      padding: 0.45rem 0.8rem;
      font-size: 0.8rem;
    }

    .button--md {
      padding: 0.7rem 1.1rem;
      font-size: 0.95rem;
    }
  }
</style>
