---
import VulnCard from "../../components/VulnCard.astro";
import Layout from "../../layouts/MainLayout.astro";

export async function getStaticPaths() {
  const vulnData = (await import("../../data/vulns.json")).default;

  return vulnData.vulnerabilities.map((vuln) => ({
    params: { writeup: vuln.cveID },
    props: { vuln },
  }));
}

const { vuln } = Astro.props;
---

<Layout>
  <section class="writeup-page">
    <div class="writeup-page__card">
      <VulnCard
        score={vuln.score}
        severity={vuln.severity}
        published={vuln.published}
        cveID={vuln.cveID}
        title={vuln.title}
        category={vuln.category}
      />
    </div>

    <h2 class="writeup-page__heading">Summary</h2>
    <p class="writeup-page__text">{vuln.summary}</p>

    <h2 class="writeup-page__heading">Writeup</h2>
    <p class="writeup-page__text">{vuln.writeup}</p>

    <h2 class="writeup-page__heading">Impact</h2>
    <p class="writeup-page__text">{vuln.impact}</p>

    <h2 class="writeup-page__heading">Affected products</h2>
    <ul class="writeup-page__list">
      {vuln.affectedProducts.map((product) => <li class="writeup-page__list-item">{product}</li>)}
    </ul>

    <h2 class="writeup-page__heading">References</h2>
    <ul class="writeup-page__list writeup-page__list--references">
      {
        vuln.references.map((ref) => (
          <li class="writeup-page__list-item">
            <a class="writeup-page__link" href={ref}>{ref}</a>
          </li>
        ))
      }
    </ul>
  </section>
</Layout>

<style>
  @layer components {
    .writeup-page {
      display: grid;
      gap: var(--space-1);
    }

    .writeup-page__card {
      margin-bottom: var(--space-1);
    }

    .writeup-page__heading {
      margin-top: var(--space-6);
      margin-bottom: var(--space-1);
    }

    .writeup-page__text,
    .writeup-page__list {
      margin-top: var(--space-1);
    }

    .writeup-page__list--references {
      overflow-wrap: anywhere;
    }
  }
</style>
