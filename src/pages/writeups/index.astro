---
import Layout from '../../layouts/MainLayout.astro';
import vulnData from '../../data/vulns.json';

const { vulnerabilities } = vulnData;
---

<Layout>
  <section class="writeups-page">
    <p class="hero__eyebrow">// incident log</p>
    <h1>Writeups</h1>
    <ul>
      {vulnerabilities.map((vuln) => (
        <li>
          <a href={`/writeups/${vuln.cveID}`}>{vuln.title}</a>
          <span> — {vuln.cveID}</span>
        </li>
      ))}
    </ul>
  </section>
</Layout>

<style>
  .writeups-page {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-8) 0 var(--space-3);
  }

  .hero__eyebrow {
    color: var(--color-accent-hover-2);
    font-size: var(--font-size-eyebrow);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
</style>
