---
import Layout from '../layouts/MainLayout.astro';
import Button from '../components/Button.astro';
---

<Layout>
  <section class="hero">
    <p class="hero__eyebrow">// incident response desk</p>
    <h1>generic hacker site</h1>
    <p class="hero__text">
      sbíráme, analyzujeme a prezentujeme poznatky z bezpečnostních auditu a provozních incidentů.
    </p>

    <div class="hero__actions">
      <Button href="/writeups" variant="primary">Read writeups</Button>
      <Button href="/targets" variant="secondary">Browse our targets >:)</Button>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-8) 0 var(--space-3);
  }

  .hero__eyebrow {
    color: var(--color-accent-hover-2);
    font-size: var(--font-size-eyebrow);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero__text {
    max-width: 62ch;
    color: color-mix(in srgb, var(--color-foreground) 86%, white 14%);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
</style>