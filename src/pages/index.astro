---
import Layout from '../layouts/MainLayout.astro';
import Button from '../components/Button.astro';
---

<Layout>
  <section class="hero">
    <p class="hero__eyebrow">// incident response desk</p>
    <h1>generic hacker site</h1>
    <p class="hero__text">
      sbíráme, analyzujeme a prezentujeme poznatky z bezpečnostních auditu a provozních incidentů.
    </p>

    <div class="hero__actions">
      <Button href="/targets" variant="primary">Browse targets</Button>
      <Button href="/writeups" variant="secondary">Read writeups</Button>
    </div>
  </section>
</Layout>

<style>
  .hero {
    display: grid;
    gap: 1rem;
    padding: 2rem 0 1rem;
  }

  .hero__eyebrow {
    color: var(--accentColorHover2);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .hero__text {
    max-width: 62ch;
    color: color-mix(in srgb, var(--foregroundColor) 86%, white 14%);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
</style>